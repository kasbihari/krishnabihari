# ─────────────────────────────────────────────────────────────
# Environment variables for the Krishna Bihari portfolio
# Copy this file to `.env` and fill in real values.
# Never commit the real `.env` file.
# ─────────────────────────────────────────────────────────────

# ── Supabase (client portal + admin data) ────────────────────
# Project URL and anon key are safe to expose to the browser.
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key. SERVER-ONLY — never expose to the browser.
# Used by admin pages and API routes to read/write data.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Session signing secrets ──────────────────────────────────
# Long random strings (>= 32 chars). Used to HMAC-sign the
# httpOnly admin and client-portal session cookies.
# ADMIN_SESSION_SECRET falls back to CLIENT_SESSION_SECRET if unset.
ADMIN_SESSION_SECRET=replace-with-a-long-random-string
CLIENT_SESSION_SECRET=replace-with-a-long-random-string

# ── Admin login credentials ──────────────────────────────────
# Email/password checked by the /api/admin/login route.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# ── Demo portal (development only) ───────────────────────────
# When true (default in dev), the client portal shows a sanitized
# demo workspace if no real project session is present.
# Set to "false" to disable the demo fallback.
PUBLIC_ENABLE_DEMO_PORTAL=true
