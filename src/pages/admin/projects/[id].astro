---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import ProjectManager from '../../../components/admin/ProjectManager';
import { fetchProjectDetail } from '../../../lib/server/client-admin';
import { fetchAdminClients } from '../../../lib/server/admin-data';
import { fetchProjectStatusOptions } from '../../../lib/server/project-enums';
import { getAdminSession } from '../../../lib/server/session';

export const prerender = false;

const title = 'Project';

const activeSession = getAdminSession(Astro.cookies);
if (!activeSession) {
  return Astro.redirect('/admin/login');
}

const projectId = Astro.params.id;
if (!projectId) {
  return Astro.redirect('/admin/projects');
}

const detail = await fetchProjectDetail(projectId);
if (!detail) {
  return Astro.redirect('/admin/projects');
}

const clients = await fetchAdminClients();

/*
 * Status is a PostgreSQL enum whose labels only exist in the database, so the
 * options are read back from the projects that already carry them. The
 * project's own value is always included, which keeps the editor showing the
 * true stored label.
 */
const statusOptions = await fetchProjectStatusOptions(detail.project.status ?? '');
---

<AdminLayout title={title} description="Manage a client project and its workspace.">
  <ProjectManager
    detail={detail}
    clients={clients}
    statusOptions={statusOptions}
    client:load
  />
</AdminLayout>
