---
import PortalLayout from '../../layouts/PortalLayout.astro';
import ClientDashboard from '../../components/portal/ClientDashboard';
import { getClientPortalSession } from '../../lib/server/session';

export const prerender = false;

const clientSession = getClientPortalSession(Astro.cookies);

if (!clientSession) {
  return Astro.redirect('/client');
}
---

<PortalLayout title="Client Workspace">
  <ClientDashboard client:load />
</PortalLayout>