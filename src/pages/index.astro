---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/portfolio/Hero';
import About from '../components/portfolio/About';
import Projects from '../components/portfolio/Projects';
import Skills from '../components/portfolio/Skills';
import Journey from '../components/portfolio/Journey';
import ClientPortalSection from '../components/portfolio/ClientPortalSection';
import Contact from '../components/portfolio/Contact';
import Footer from '../components/Footer';
import { fetchPublishedPortfolioProjects } from '../lib/server/portfolio';
import { getLangFromCookies } from '../i18n/server';

const lang = getLangFromCookies(Astro.cookies);
const portfolioProjects = await fetchPublishedPortfolioProjects();
---

<Layout lang={lang}>
  <Hero lang={lang} client:load />

  <About lang={lang} client:visible />

  <Projects lang={lang} projects={portfolioProjects} client:visible />

  <Skills lang={lang} client:visible />

  <Journey lang={lang} client:visible />

  <ClientPortalSection lang={lang} client:visible />

  <Contact lang={lang} client:visible />

  <Footer lang={lang} client:load />
</Layout>
