---
import '../styles/global.css';
import AdminNav from '../components/admin/AdminNav';
import HeadMeta from '../components/system/HeadMeta.astro';
import GlobalBackground from '../components/system/GlobalBackground.astro';
import { getLangFromCookies } from '../i18n/server';
import { getDict } from '../i18n';

export interface Props {
  title?: string;
  description?: string;
  /** The login screen is a full-bleed terminal — no admin chrome. */
  bare?: boolean;
}

const {
  title = 'Developer Admin',
  description = 'Private developer dashboard for managing clients and projects.',
  bare = false,
} = Astro.props;

/*
  The admin shares the site's one language and theme system. Its own copy is
  still English-only, so `lang` keeps describing the content accurately and no
  language picker is offered here — a control that changes nothing would be a
  lie. The theme picker is offered because it genuinely applies.
*/
const lang = getLangFromCookies(Astro.cookies);
const t = getDict(lang);

const canonicalURL = new URL(
  Astro.url.pathname,
  Astro.site ?? 'https://krishnabihari.vercel.app',
);
---

<!doctype html>
<html lang="en">
  <head>
    <HeadMeta
      title={title}
      description={description}
      lang="en"
      canonical={canonicalURL.href}
      noindex={true}
    />
  </head>

  <body>
    <GlobalBackground />

    {!bare && (
      <AdminNav
        currentPath={Astro.url.pathname}
        themeLabels={{
          light: t.nav.themeLight,
          dark: t.nav.themeDark,
          system: t.nav.themeSystem,
        }}
        themeAriaLabel={t.nav.switchTheme}
        client:load
      />
    )}
    <slot />
  </body>
</html>
