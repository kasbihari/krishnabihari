---
import '../styles/global.css';
import AdminNav from '../components/admin/AdminNav';
import HeadMeta from '../components/system/HeadMeta.astro';

export interface Props {
  title?: string;
  description?: string;
  /** The login screen is a full-bleed terminal — no admin chrome. */
  bare?: boolean;
}

const {
  title = 'Developer Admin',
  description = 'Private developer dashboard for managing clients and projects.',
  bare = false,
} = Astro.props;

const canonicalURL = new URL(
  Astro.url.pathname,
  Astro.site ?? 'https://krishnabihari.vercel.app',
);
---

<!doctype html>
<html lang="en">
  <head>
    <HeadMeta
      title={title}
      description={description}
      lang="en"
      canonical={canonicalURL.href}
      noindex={true}
    />
  </head>

  <body>
    {!bare && <AdminNav currentPath={Astro.url.pathname} />}
    <slot />
  </body>
</html>
