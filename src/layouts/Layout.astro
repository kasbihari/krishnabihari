---
import '../styles/global.css';
import Navbar from '../components/Navbar';
import HeadMeta from '../components/system/HeadMeta.astro';
import GlobalBackground from '../components/system/GlobalBackground.astro';
import RevealScript from '../components/system/RevealScript.astro';
import Preloader from '../components/system/Preloader.astro';
import { getLangFromCookies, localizedMeta } from '../i18n/server';
import type { Lang } from '../i18n';

export interface Props {
  title?: string;
  description?: string;
  lang?: Lang;
}

const lang = Astro.props.lang ?? getLangFromCookies(Astro.cookies);
const meta = localizedMeta(lang);

const { title = meta.title, description = meta.description } = Astro.props;

const canonicalURL = new URL(
  Astro.url.pathname,
  Astro.site ?? 'https://krishnabihari.vercel.app',
);
---

<!doctype html>
<html lang={lang}>
  <head>
    <HeadMeta
      title={title}
      description={description}
      lang={lang}
      canonical={canonicalURL.href}
      ogType="website"
    />
    <meta property="og:image" content="https://krishnabihari.vercel.app/images/preview.png" />
    <meta name="twitter:image" content="https://krishnabihari.vercel.app/images/preview.png" />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: 'Krishna Bihari',
      url: 'https://krishnabihari.vercel.app/',
      jobTitle: 'Full-Stack & AI Engineer',
      email: 'mailto:kas.bihari@gmail.com',
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Amsterdam',
        addressCountry: 'NL',
      },
      sameAs: [
        'https://github.com/kasbihari',
        'https://www.linkedin.com/in/krishna-bihari/',
      ],
      knowsAbout: [
        'Full-stack development',
        'AI integration',
        'Voice automation',
        'SaaS products',
        'React',
        'Node.js',
      ],
    })} />
  </head>

  <body>
    <Preloader />

    <GlobalBackground />

    <a href="#home" class="skip-link">Skip to content</a>

    <Navbar lang={lang} client:load />

    <main id="main">
      <slot />
    </main>

    <RevealScript />

    <style>
      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 200;
        padding: 0.75rem 1.25rem;
        background: var(--verde);
        color: var(--on-accent);
        border-radius: 0 0 var(--radius-sm) 0;
        font-size: 0.85rem;
      }

      .skip-link:focus {
        left: 0;
      }
    </style>
  </body>
</html>
