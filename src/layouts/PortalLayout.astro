---
import '../styles/global.css';
import HeadMeta from '../components/system/HeadMeta.astro';

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Client Portal',
  description = 'Private client portal for project updates and milestone tracking.',
} = Astro.props;

const canonicalURL = new URL(
  Astro.url.pathname,
  Astro.site ?? 'https://krishnabihari.vercel.app',
);
---

<!doctype html>
<html lang="en">
  <head>
    <HeadMeta
      title={title}
      description={description}
      lang="en"
      canonical={canonicalURL.href}
      noindex={true}
    />
  </head>

  <body>
    <div id="client-portal-root">
      <slot />
    </div>

    <style is:global>
      /* ──────────────────────────────────────────────────────────
         The portal shares the public design system. These rules only
         map the portal's existing class hooks onto it, so the portal
         components keep working without being rewritten.
         ────────────────────────────────────────────────────────── */

      #client-portal-root {
        min-height: 100vh;
        position: relative;
        z-index: var(--z-content);
      }

      /* The portal drives its own reveal engine via [data-portal-reveal].
         Neutralise the public [data-reveal] rule so the two never fight. */
      #client-portal-root [data-reveal] {
        opacity: 1;
        transform: none;
        filter: none;
      }

      #client-portal-root [data-portal-reveal] {
        opacity: 0;
        transform: translate3d(0, 24px, 0);
        filter: blur(5px);
        transition:
          opacity var(--dur-reveal) var(--ease-out),
          transform var(--dur-reveal) var(--ease-out),
          filter var(--dur-reveal) var(--ease-out);
      }

      #client-portal-root [data-portal-reveal].is-visible {
        opacity: 1;
        transform: translate3d(0, 0, 0);
        filter: blur(0);
      }

      #client-portal-root .portal-motion-slow[data-portal-reveal] {
        transition-duration: 1200ms;
      }

      /* ── Loading ── */
      #client-portal-root .portal-loading-card {
        border: 1px solid var(--glass-border);
        background: var(--glass-2);
        -webkit-backdrop-filter: blur(var(--glass-blur-2)) saturate(var(--glass-sat));
        backdrop-filter: blur(var(--glass-blur-2)) saturate(var(--glass-sat));
        box-shadow: var(--glass-inner), var(--glass-shadow);
        border-radius: var(--radius-lg);
      }

      #client-portal-root .portal-loading-fill {
        background: linear-gradient(90deg, var(--verde), var(--verde-ink));
        border-radius: 99px;
        animation: portal-loading-pulse 1.8s var(--ease-inout) infinite;
      }

      @keyframes portal-loading-pulse {
        0%, 100% { opacity: 0.45; }
        50%      { opacity: 1; }
      }

      /* ── Dashboard header ── */
      #client-portal-root .portal-dashboard__header {
        border: 1px solid var(--glass-border);
        background: var(--glass-2);
        -webkit-backdrop-filter: blur(var(--glass-blur-2)) saturate(var(--glass-sat));
        backdrop-filter: blur(var(--glass-blur-2)) saturate(var(--glass-sat));
        box-shadow: var(--glass-inner), var(--glass-shadow);
        border-radius: var(--radius-lg);
        transition:
          border-color var(--dur-base) var(--ease-out),
          background var(--dur-base) var(--ease-out);
      }

      #client-portal-root .portal-dashboard__header:hover {
        border-color: var(--glass-border-hover);
      }

      #client-portal-root .portal-dashboard__logout {
        border-radius: var(--radius-pill);
      }

      /* ── Cards ── */
      #client-portal-root .portal-card-hover {
        position: relative;
        border: 1px solid var(--glass-border);
        background: var(--glass-1);
        -webkit-backdrop-filter: blur(var(--glass-blur-1)) saturate(var(--glass-sat));
        backdrop-filter: blur(var(--glass-blur-1)) saturate(var(--glass-sat));
        box-shadow: var(--glass-inner), var(--glass-shadow);
        border-radius: var(--radius-lg);
        overflow: hidden;
        transition:
          border-color var(--dur-base) var(--ease-out),
          background var(--dur-base) var(--ease-out),
          box-shadow var(--dur-base) var(--ease-out),
          transform var(--dur-base) var(--ease-out);
      }

      #client-portal-root .portal-card-hover:hover {
        border-color: var(--glass-border-hover);
        background: var(--glass-2);
        box-shadow: var(--glass-inner), var(--glass-shadow-hover);
        transform: translateY(-2px);
      }

      /* Soft light sweep on hover — the "liquid" read */
      #client-portal-root .portal-card-hover::after {
        content: '';
        position: absolute;
        inset: 0;
        border-radius: inherit;
        pointer-events: none;
        opacity: 0;
        background: radial-gradient(
          420px circle at 50% 0%,
          var(--verde-glow),
          transparent 62%
        );
        transition: opacity var(--dur-slow) var(--ease-out);
      }

      #client-portal-root .portal-card-hover:hover::after {
        opacity: 1;
      }

      #client-portal-root .portal-card-hover .portal-hover-item {
        transition:
          background var(--dur-base) var(--ease-out),
          border-color var(--dur-base) var(--ease-out);
      }

      #client-portal-root .portal-card-hover .portal-hover-item:hover {
        background: var(--glass-2);
        border-color: var(--glass-border-hover);
      }

      @media (max-width: 640px) {
        #client-portal-root .portal-card-hover:hover {
          transform: none;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        #client-portal-root [data-portal-reveal] {
          opacity: 1;
          transform: none;
          filter: none;
        }

        #client-portal-root .portal-card-hover,
        #client-portal-root .portal-card-hover::after,
        #client-portal-root .portal-card-hover .portal-hover-item {
          transition: none;
        }
      }
    </style>

    <script is:inline>
      (function () {
        function boot() {
          var root = document.getElementById('client-portal-root');
          if (!root) return;

          var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

          function revealElement(element) {
            if (element.dataset.revealReady === 'true') return;
            element.dataset.revealReady = 'true';

            if (reducedMotion) {
              element.classList.add('is-visible');
              return;
            }

            var parsed = Number.parseInt(element.dataset.delay || '0', 10);
            var delay = Number.isFinite(parsed) ? Math.max(parsed, 0) : 0;

            window.setTimeout(function () {
              element.classList.add('is-visible');
            }, delay);
          }

          function revealVisibleElements() {
            root.querySelectorAll('[data-portal-reveal]').forEach(function (element) {
              var rect = element.getBoundingClientRect();
              var isVisible = rect.top < window.innerHeight * 0.88 && rect.bottom > 0;
              if (isVisible) revealElement(element);
            });
          }

          if (reducedMotion) {
            root.querySelectorAll('[data-portal-reveal]').forEach(revealElement);
            return;
          }

          if (typeof IntersectionObserver !== 'undefined') {
            var observer = new IntersectionObserver(
              function (entries) {
                entries.forEach(function (entry) {
                  if (!entry.isIntersecting) return;
                  revealElement(entry.target);
                  observer.unobserve(entry.target);
                });
              },
              { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
            );

            function observeElements() {
              root.querySelectorAll('[data-portal-reveal]').forEach(function (element) {
                if (element.dataset.revealReady === 'true') return;
                observer.observe(element);
              });
            }

            observeElements();

            new MutationObserver(observeElements).observe(root, {
              childList: true,
              subtree: true,
            });

            // Catch elements added during React hydration immediately.
            window.setTimeout(revealVisibleElements, 100);
            return;
          }

          // Fallback: no IntersectionObserver.
          new MutationObserver(function () {
            root.querySelectorAll('[data-portal-reveal]').forEach(revealElement);
          }).observe(root, { childList: true, subtree: true });

          root.querySelectorAll('[data-portal-reveal]').forEach(revealElement);
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', boot);
        } else {
          boot();
        }
      })();
    </script>
  </body>
</html>
