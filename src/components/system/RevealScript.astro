---
/**
 * Shared cinematic reveal engine.
 *
 * Observes every [data-reveal] element, adds .is-visible when it enters the
 * viewport, honours data-delay, and drives .skill-bar-fill widths from
 * data-width. Re-scans on DOM mutation so React islands that mount later are
 * picked up too. Respects prefers-reduced-motion.
 */
---

<script is:inline>
  (function () {
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function show(el) {
      el.classList.add('is-visible');
      el.classList.add('revealed');
      el.style.willChange = 'auto';
    }

    function fillBars(root) {
      var bars = root.querySelectorAll('.skill-bar-fill[data-width]');
      for (var i = 0; i < bars.length; i++) {
        bars[i].style.width = bars[i].getAttribute('data-width') + '%';
      }
    }

    function init() {
      var nodes = document.querySelectorAll('[data-reveal]:not([data-reveal-ready])');

      if (reduce || !('IntersectionObserver' in window)) {
        for (var i = 0; i < nodes.length; i++) {
          nodes[i].setAttribute('data-reveal-ready', '');
          show(nodes[i]);
        }
        fillBars(document);
        return;
      }

      var observer = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            if (!entry.isIntersecting) return;
            var el = entry.target;
            var delay = parseInt(el.getAttribute('data-delay') || '0', 10);
            if (delay > 0) {
              setTimeout(function () {
                show(el);
              }, delay);
            } else {
              show(el);
            }
            fillBars(el);
            observer.unobserve(el);
          });
        },
        { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
      );

      for (var j = 0; j < nodes.length; j++) {
        nodes[j].setAttribute('data-reveal-ready', '');
        observer.observe(nodes[j]);
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }

    // Pick up islands that hydrate after the first pass.
    var scheduled = false;
    var mo = new MutationObserver(function () {
      if (scheduled) return;
      scheduled = true;
      requestAnimationFrame(function () {
        scheduled = false;
        init();
      });
    });
    mo.observe(document.documentElement, { childList: true, subtree: true });
  })();
</script>
