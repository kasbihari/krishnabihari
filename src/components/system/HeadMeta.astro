---
/**
 * Shared <head> contents for every layout (public, portal, admin).
 * Single source of truth for fonts, theme bootstrap and route transitions.
 */
export interface Props {
  title: string;
  description?: string;
  lang?: string;
  canonical?: string;
  ogType?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'Full-stack developer and AI engineer from the Netherlands building web applications, AI-powered automations, and SaaS products.',
  lang = 'en',
  canonical,
  ogType = 'website',
  noindex = false,
} = Astro.props;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<title>{title}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
{canonical && <link rel="canonical" href={canonical} />}

<meta property="og:type" content={ogType} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{canonical && <meta property="og:url" content={canonical} />}
<meta property="og:locale" content={lang} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

<!-- Fonts: Amsterdam Four is local; Playfair + Mukta from Google -->
<link rel="preload" href="/fonts/Amsterdam.ttf" as="font" type="font/ttf" crossorigin />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Mukta:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,400;0,500;1,400;1,500&display=swap"
  rel="stylesheet"
/>

<!--
  Theme bootstrap. Runs before first paint so there is never a flash of the
  wrong theme, and so the theme persists across / → /client → /admin.

  Three modes: light, dark, system. `system` is the default and follows
  prefers-color-scheme; the listener is installed here, outside the React
  islands, so even a route with no interactive controls still tracks the OS.
  Dark is the primary identity when the OS expresses no preference.
-->
<script is:inline>
  (function () {
    var KEY = 'kb-theme';
    var root = document.documentElement;
    var mode = 'system';

    try {
      var stored = window.localStorage.getItem(KEY);
      if (stored === 'light' || stored === 'dark' || stored === 'system') {
        mode = stored;
      }
    } catch (e) {
      /* storage blocked — system mode still works */
    }

    var mq = window.matchMedia('(prefers-color-scheme: dark)');

    function resolved(target) {
      return target === 'system' ? (mq.matches ? 'dark' : 'light') : target;
    }

    root.setAttribute('data-theme', resolved(mode));
    root.setAttribute('data-theme-mode', mode);

    function onSystemChange() {
      if (root.getAttribute('data-theme-mode') !== 'system') return;
      root.setAttribute('data-theme', mq.matches ? 'dark' : 'light');
    }

    if (mq.addEventListener) {
      mq.addEventListener('change', onSystemChange);
    } else if (mq.addListener) {
      mq.addListener(onSystemChange);
    }
  })();
</script>
