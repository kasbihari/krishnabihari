---
/**
 * Cinematic entry preloader — circular ring redesign.
 *
 * A full-screen, minimal opening sequence shown on first entry to the
 * portfolio. The real logo-mark.svg sits at the center, surrounded by a
 * thin SVG progress ring, with the percentage underneath. The background
 * is always deep black so the white logo mark reads as authored in both
 * themes.
 *
 * Behaviour:
 *  - Entrance is pure CSS (opacity/transform keyframes, compositor-friendly).
 *  - The ring and percentage reflect real readiness: they move to 70% when
 *    the critical fonts resolve (document.fonts.ready) and to 100% on
 *    reveal. The number eases toward each target so it reads as smooth
 *    without faking progress.
 *  - Reveal happens when fonts are ready AND a short minimum has elapsed;
 *    a hard timeout guarantees the site can never be stuck behind the
 *    loader. Repeat visitors (localStorage flag) get a shorter minimum.
 *    prefers-reduced-motion users get a static composition that clears as
 *    soon as fonts are ready.
 *  - Exit: the ring expands outward and fades while the logo stays centered
 *    briefly, then the black background dissolves to reveal the homepage
 *    already rendered underneath — no blank frame.
 *  - If JavaScript fails entirely, a CSS-only fallback animation fades the
 *    loader out after 4s, so the portfolio always becomes accessible.
 *
 * No new dependencies, no React island, no network requests beyond the logo
 * the navbar already loads.
 */
---

<div class="kb-preloader" id="kb-preloader" role="status" aria-live="polite" data-state="entering">
  <div class="kb-preloader__inner">
    <div class="kb-preloader__stage">
      <svg class="kb-preloader__ring" viewBox="0 0 200 200" aria-hidden="true">
        <circle class="kb-preloader__ring-track" cx="100" cy="100" r="92" pathLength="100" />
        <circle
          class="kb-preloader__ring-progress"
          cx="100"
          cy="100"
          r="92"
          pathLength="100"
          transform="rotate(-90 100 100)"
        />
      </svg>
      <img
        src="/images/logo-mark.svg"
        alt=""
        aria-hidden="true"
        class="kb-preloader__logo"
        width="500"
        height="500"
        decoding="async"
      />
    </div>
    <p class="kb-preloader__percent">0%</p>
  </div>
</div>

<style>
  .kb-preloader {
    position: fixed;
    inset: 0;
    z-index: 120;
    display: grid;
    place-items: center;
    overflow: hidden;
    background: #050505;
    opacity: 1;
    visibility: visible;
    transition:
      opacity 700ms var(--ease-out) 200ms,
      visibility 0s linear 900ms;
    /* CSS-only fallback: if the inline script never runs, the loader
       still clears itself so the site can never be blocked. */
    animation: kbPreloaderFallback 500ms var(--ease-out) 4s forwards;
  }

  .kb-preloader[data-state='done'] {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .kb-preloader__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding:
      max(1rem, env(safe-area-inset-top))
      max(1rem, env(safe-area-inset-right))
      max(1rem, env(safe-area-inset-bottom))
      max(1rem, env(safe-area-inset-left));
  }

  /* ── Stage: ring + logo, logo centered inside the ring ── */
  .kb-preloader__stage {
    --kb-ring-size: clamp(190px, 36vw, 250px);
    position: relative;
    width: var(--kb-ring-size);
    height: var(--kb-ring-size);
  }

  .kb-preloader__ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 1;
    animation: kbPreloaderFadeIn 500ms var(--ease-out) 150ms backwards;
    transition:
      transform 700ms var(--ease-out),
      opacity 500ms var(--ease-out);
  }

  .kb-preloader__ring-track {
    fill: none;
    stroke: var(--line);
    stroke-width: 1.75;
  }

  .kb-preloader__ring-progress {
    fill: none;
    stroke: var(--verde-ink);
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
  }

  .kb-preloader__logo {
    position: absolute;
    top: 50%;
    left: 50%;
    width: clamp(56px, 10vw, 92px);
    height: clamp(56px, 10vw, 92px);
    object-fit: contain;
    user-select: none;
    -webkit-user-drag: none;
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
    animation: kbPreloaderLogo 800ms var(--ease-out) 60ms backwards;
    transition: opacity 400ms var(--ease-out) 100ms;
  }

  .kb-preloader__percent {
    font-family: var(--font-mono);
    font-size: clamp(0.68rem, 1.3vw, 0.8rem);
    letter-spacing: 0.12em;
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
    margin-top: clamp(1rem, 2.5vh, 1.5rem);
    opacity: 1;
    animation: kbPreloaderFadeIn 400ms var(--ease-out) 350ms backwards;
    transition:
      opacity 300ms var(--ease-out),
      color 400ms var(--ease-out);
  }

  .kb-preloader__percent[data-ready='true'] {
    color: var(--verde-ink);
  }

  /* ── Cinematic exit ──
     The ring expands outward and fades while the logo stays centered
     briefly; then the black background dissolves, revealing the homepage
     already rendered underneath. No hard cut, no blank frame. */
  .kb-preloader[data-state='done'] .kb-preloader__ring {
    transform: scale(1.55);
    opacity: 0;
  }

  .kb-preloader[data-state='done'] .kb-preloader__logo {
    opacity: 0;
  }

  .kb-preloader[data-state='done'] .kb-preloader__percent {
    opacity: 0;
  }

  @keyframes kbPreloaderLogo {
    from {
      opacity: 0;
      transform: translate(-50%, -50%) scale(0.92);
    }
  }

  @keyframes kbPreloaderFadeIn {
    from {
      opacity: 0;
    }
  }

  @keyframes kbPreloaderFallback {
    to {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }
  }

  /* Short viewports (landscape phones): tighten the composition so it
     never clips or scrolls. */
  @media (max-height: 480px) {
    .kb-preloader__stage {
      --kb-ring-size: 150px;
    }

    .kb-preloader__logo {
      width: 44px;
      height: 44px;
    }

    .kb-preloader__percent {
      margin-top: 0.6rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .kb-preloader__ring,
    .kb-preloader__logo,
    .kb-preloader__percent {
      animation: none;
      opacity: 1;
    }

    .kb-preloader__logo {
      transform: translate(-50%, -50%);
    }

    .kb-preloader[data-state='done'] .kb-preloader__ring {
      transform: none;
    }

    .kb-preloader[data-state='done'] {
      transition: opacity 300ms linear;
    }
  }
</style>

<script is:inline>
  (function () {
    var el = document.getElementById('kb-preloader');
    if (!el) return;

    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var done = false;
    var MAX = reduce ? 2000 : 3500;

    var ring = el.querySelector('.kb-preloader__ring-progress');
    var percent = el.querySelector('.kb-preloader__percent');
    var current = 0;
    var target = 0;
    var rafId = null;

    function render(value) {
      if (ring) ring.style.strokeDashoffset = String(100 - value);
      if (percent) percent.textContent = Math.round(value) + '%';
    }

    function setProgress(value) {
      target = value;
      if (reduce) {
        current = value;
        render(value);
        return;
      }
      if (rafId !== null) return;
      var start = current;
      var startTime = null;
      function step(ts) {
        if (startTime === null) startTime = ts;
        var t = Math.min(1, (ts - startTime) / 550);
        var eased = t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2;
        current = start + (target - start) * eased;
        render(current);
        if (t < 1) {
          rafId = requestAnimationFrame(step);
        } else {
          rafId = null;
        }
      }
      rafId = requestAnimationFrame(step);
    }

    function reveal() {
      if (done) return;
      done = true;
      try {
        window.localStorage.setItem('kb-preloader', '1');
      } catch (e) {
        /* ignore */
      }
      setProgress(100);
      if (percent) percent.setAttribute('data-ready', 'true');
      setTimeout(function () {
        el.setAttribute('data-state', 'done');
        setTimeout(function () {
          if (el.parentNode) el.parentNode.removeChild(el);
        }, reduce ? 0 : 900);
      }, reduce ? 0 : 450);
    }

    /* Hard ceiling registered first — the site can never be stuck. */
    setTimeout(reveal, MAX);
    /* JS is in control now; the CSS fallback is no longer needed. */
    el.style.animation = 'none';

    var MIN = 1200; /* first visit — let the entrance sequence read */
    var seen = false;
    try {
      seen = window.localStorage.getItem('kb-preloader') === '1';
    } catch (e) {
      /* storage blocked — treat as first visit */
    }
    if (seen) MIN = 600; /* repeat visit — shorter transition */
    if (reduce) MIN = 0;

    var fontsReady =
      document.fonts && document.fonts.ready
        ? document.fonts.ready
        : Promise.resolve();

    /* The ring reflects real readiness: critical fonts loaded → 70%. */
    fontsReady.then(function () {
      if (!done) setProgress(70);
    });

    var minWait = new Promise(function (resolve) {
      setTimeout(resolve, MIN);
    });

    Promise.all([fontsReady, minWait]).then(reveal);
  })();
</script>
