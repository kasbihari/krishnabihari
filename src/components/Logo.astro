---
/**
 * The brand mark, for non-interactive placements.
 *
 * This renders the supplied artwork itself (`/images/logo-mark.svg`) rather
 * than redrawing it, so every placement on the site shows the same asset as
 * the navigation. Tone is adapted per theme by `.kb-logo-mark` in global.css,
 * which is required because the artwork is a white mark on transparency.
 *
 * `size` is the visible mark; the artwork carries its own internal padding.
 */
export interface Props {
  size?: number;
  class?: string;
}

const { size = 40, class: className = '' } = Astro.props;
---

<img
  src="/images/logo-mark.svg"
  alt=""
  aria-hidden="true"
  class:list={['kb-logo-mark', className]}
  style={`--kb-logo-size: ${size}px`}
  width="500"
  height="500"
  decoding="async"
/>
